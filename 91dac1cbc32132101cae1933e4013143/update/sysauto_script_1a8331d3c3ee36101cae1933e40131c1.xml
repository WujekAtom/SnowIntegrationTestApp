        <script><![CDATA[var xDaysAgo = new GlideDateTime(); // current local datetime
xDaysAgo.addDaysLocalTime(-1); // substracting 1 day; setting new day for searching incidents

var gr = new GlideRecord('incident');
gr.addQuery('state', 6);
gr.addQuery('reopen_count', 0);
gr.addQuery('sys_created_on', '<', xDaysAgo);
gr.query();

while (gr.next()){
	// close found resolved incidents

	gr.setValue('state', 7);
	gr.update();

	gs.info('Incident ' + gr.getValue('number') + ' closed');

}]]></script>
